# 小源 QQ 机器人 - 项目 gitignore

# 环境变量（含 API Key）
.env

# 用户自定义的人设和记忆库
data/persona.md
data/memory.md

# 数据库和向量存储
data/xiaomo.db
data/xiaomo.db-shm
data/xiaomo.db-wal
data/vector_db/
data/bot.pid
data/startup_history/

# Python
__pycache__/
*.pyc
*.pyo
src/*.egg-info/
*.egg

# Claude Code
.claude/

# IDE
.vscode/
.idea/

# 日志
*.log

# 天气缓存
data/weather_test.txt

# 调试残留
data/_debug_segments.json

# NapCat 下载工具残留
data/napcat_release.json

# LLBot 安装目录（用户自行下载 https://github.com/LLOneBot/LuckyLilliaBot/releases）
llbot/
