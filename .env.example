# ===== NoneBot2 基础配置 =====
ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=[]
NICKNAME=["小源"]
COMMAND_START=["/", ""]
COMMAND_SEP=[" "]

# ===== OneBot v11 连接 (正向 WebSocket) =====
ONEBOT_WS_URL=ws://127.0.0.1:3001

# ===== OneBot v11 连接 (反向 WebSocket - NapCatQQ 默认) =====
# 如果使用反向WS，NapCatQQ 会连接到此地址，无需设置 ONEBOT_WS_URL
# ONEBOT_ACCESS_TOKEN=

# ===== MiMo-V2.5 API (LLM 对话，支持文本 + 视觉) =====
LLM_API_KEY=sk-xxxxx
LLM_API_BASE=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5

# ===== 视觉识别 (MiMo-V2.5 同款模型) =====
VISION_API_KEY=sk-xxxxx
VISION_API_BASE=https://api.xiaomimimo.com/v1
VISION_MODEL=mimo-v2.5

# ===== 数据库路径 =====
DATABASE_PATH=data/xiaomo.db

# ===== Tavily 联网搜索 API =====
TAVILY_API_KEY=tvly-xxxxx

# ===== HuggingFace 镜像 (国内加速) =====
HF_ENDPOINT=https://hf-mirror.com
