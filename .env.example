# ===== NoneBot2 基础配置 =====
ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=[]
NICKNAME=["小源"]
COMMAND_START=["/", ""]
COMMAND_SEP=[" "]

# ===== OneBot v11 连接 (正向 WebSocket) =====
ONEBOT_WS_URL=ws://127.0.0.1:3001

# ===== OneBot v11 连接 (反向 WebSocket - NapCatQQ 默认) =====
# 如果使用反向WS，NapCatQQ 会连接到此地址，无需设置 ONEBOT_WS_URL
# ONEBOT_ACCESS_TOKEN=

# ===== DeepSeek API (LLM 对话) =====
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== 视觉识别 (兼容 OpenAI Vision API) =====
VISION_API_KEY=sk-xxxxx
VISION_API_BASE=https://api.xiaomimimo.com/v1
VISION_MODEL=mimo-v2.5

# ===== 数据库路径 =====
DATABASE_PATH=data/xiaomo.db

# ===== HuggingFace 镜像 (国内加速) =====
HF_ENDPOINT=https://hf-mirror.com
